{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5100",
        "Protocols": "Http2"
      },
      "Health": {
        "Url": "http://localhost:5101",
        "Protocols": "Http1"
      }
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "tracking"
  },
  "Ingest": {
    "MaxClockSkew": "00:02:00",
    "MaxPingAge": "1.00:00:00",
    "OutboxCapacity": 256,
    "InboundCapacity": 64,
    "AppendQueueCapacity": 4096,
    "MaxBatchSize": 256
  }
}
