{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Urls": "http://localhost:5400",
  "ConnectionStrings": {
    "Analytics": "Host=localhost;Port=5432;Database=tracking_analytics;Username=tracking;Password=tracking"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PositionsTopic": "tracking.positions.v1",
    "GeofenceEventsTopic": "tracking.geofence-events.v1"
  },
  "AnalyticsConsumer": {
    "GroupId": "tracking-analytics",
    "BatchSize": 500,
    "PollTimeout": "00:00:01"
  },
  "AnalyticsService": {
    "ApplyMigrations": true,
    "LedgerRetention": "7.00:00:00",
    "LedgerPruneInterval": "01:00:00",
    "ErrorDelay": "00:00:01",
    "MaxErrorDelay": "00:00:30"
  },
  "Analytics": {
    "DwellThreshold": "00:05:00"
  }
}
