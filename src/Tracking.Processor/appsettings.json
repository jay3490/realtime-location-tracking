{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5300",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "tracking",
    "ConsumerGroup": "processors"
  },
  "Processor": {
    "BatchSize": 100,
    "MinIdleDelay": "00:00:00.050",
    "MaxIdleDelay": "00:00:01",
    "ErrorDelay": "00:00:01",
    "MaxErrorDelay": "00:00:30",
    "ClaimMinIdle": "00:00:30",
    "ClaimInterval": "00:00:10",
    "GeofenceRefreshInterval": "00:00:02",
    "MaxCommitAttempts": 5,
    "MaxDeliveryAttempts": 5,
    "MaxDeliveryCount": 20,
    "LagSampleInterval": "00:00:05",
    "StallTimeout": "00:01:00",
    "PublishAnalytics": true
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PositionsTopic": "tracking.positions.v1",
    "GeofenceEventsTopic": "tracking.geofence-events.v1",
    "Acks": "All",
    "EnableIdempotence": true,
    "LingerMs": 5,
    "Compression": "Lz4",
    "DeliveryTimeout": "00:00:30"
  }
}
